<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
  </PropertyGroup>

	<PropertyGroup>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageId>Cake.Storm.Tolgee</PackageId>
		<PackageVersion>1.0.0</PackageVersion>
		<Authors>Julien Mialon</Authors>
		<Company>Julien Mialon</Company>
		<Description>A set of aliases for Cake to interact with tolgee translation platform.</Description>
		<Copyright>Copyright 2023</Copyright>
		<PackageProjectUrl>https://github.com/Julien-Mialon/Cake.Storm.Tolgee</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Julien-Mialon/Cake.Storm.Tolgee</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>
			# 1.0.0
			- Initial release
		</PackageReleaseNotes>
	</PropertyGroup>

	<!-- Source link -->
	<PropertyGroup>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>
	
	<!-- scripts embedding -->
	<ItemGroup>
		<Content Include="scripts/*.cake" Pack="false" />
	</ItemGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackVersionedScript</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<!-- An unversioned #addin floats to the latest release, whatever version consumers #load. -->
	<Target Name="PackVersionedScript">
		<PropertyGroup>
			<VersionedScriptPath>$(IntermediateOutputPath)Cake.Storm.Tolgee.cake</VersionedScriptPath>
			<VersionedScriptContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/scripts/Cake.Storm.Tolgee.cake').Replace('$version$', '$(PackageVersion)'))</VersionedScriptContent>
		</PropertyGroup>
		<WriteLinesToFile File="$(VersionedScriptPath)" Lines="$([MSBuild]::Escape($(VersionedScriptContent)))" Overwrite="true" />
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(VersionedScriptPath)" PackagePath="scripts" />
		</ItemGroup>
	</Target>

  <ItemGroup>
    <PackageReference Include="Cake.Common" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Cake.Core" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
